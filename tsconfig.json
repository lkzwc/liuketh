{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"strictNullChecks": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": [
			"astro/client",
			"astro/astro-jsx",
			"@astrojs/react/client"
		],
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		},
		"allowJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}