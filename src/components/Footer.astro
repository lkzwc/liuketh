---
import { Image } from "astro:assets";
import logo from "../image/index/logo_w.png";
---

<footer class="relative px-10">
  <div
    class="absolute inset-0 bg-gradient-to-b from-indigo-900 via-purple-900 to-pink-800"
  >
  </div>
  <div
    class="absolute inset-0 bg-[url(/grid.svg)] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]"
  >
  </div>

  <div class="container mx-auto px-4 py-16 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- 公司信息 -->
      <div class="space-y-6">
        <Image
          src={logo}
          alt="流客科技"
          width={180}
          height={50}
          class="rounded-lg hover:scale-105 transition-transform duration-300 shadow-lg"
        />
        <p class="text-gray-300 text-sm leading-relaxed">
          流客科技专注于为用户提供优质的通信服务解决方案,包括流量卡、随身WiFi等产品。
        </p>
      </div>

      <!-- 产品服务 -->
      <div>
        <h3
          class="text-lg font-semibold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-400"
        >
          产品服务
        </h3>
        <ul class="space-y-3">
          <li>
            <a href="/hotcard" class="footer-link group">
              <span class="relative">
                流量卡
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
          <li>
            <a href="/wifi" class="footer-link group">
              <span class="relative">
                随身WiFi
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
          <li>
            <a href="/product" class="footer-link group">
              <span class="relative">
                最新产品
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- 关于我们 -->
      <div>
        <h3
          class="text-lg font-semibold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-400"
        >
          关于我们
        </h3>
        <ul class="space-y-3">
          <li>
            <a href="/about" class="footer-link group">
              <span class="relative">
                公司介绍
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
          <li>
            <a href="/agent" class="footer-link group">
              <span class="relative">
                代理合作
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
          <li>
            <a href="/news" class="footer-link group">
              <span class="relative">
                新闻资讯
                <span
                  class="absolute -bottom-0.5 left-0 w-full h-0.5 bg-gradient-to-r from-pink-500 to-purple-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                ></span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- 联系方式 -->
      <div>
        <h3
          class="text-lg font-semibold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-400"
        >
          联系我们
        </h3>
        <div class="space-y-4">
          <div
            class="sm:p-1 md:p-3 bg-white/5 rounded-lg group-hover:bg-white/10 transition-colors duration-300 w-full"
          >
            <a href="tel:15556355573" class="contact-link group block">
              <div class="flex items-center space-x-3">
                <svg
                  class="w-5 text-pink-400 flex-shrink-0"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                <span
                  class="text-gray-300 group-hover:text-white transition-colors"
                >
                  15556355573
                </span>
              </div>
            </a>
          </div>

          <div
            class="sm:p-1 md:p-3 bg-white/5 rounded-lg group-hover:bg-white/10 transition-colors duration-300 w-full"
          >
            <a href="mailto:liuketh@qq.com" class="contact-link group block">
              <div class="flex items-center space-x-3">
                <svg
                  class="w-5 text-pink-400 flex-shrink-0"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                  ></path>
                  <path
                    d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                  ></path>
                </svg>
                <span
                  class="text-gray-300 group-hover:text-white transition-colors truncate"
                >
                  liuketh@qq.com
                </span>
              </div>
            </a>
          </div>

          <!-- 微信二维码提示 -->
          <div class="sm:p-1 md:p-3 bg-white/5 rounded-lg w-full">
            <div class="flex items-center space-x-3">
              <svg class="w-5 text-pink-400 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 01.213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 00.167-.054l1.903-1.114a.864.864 0 01.717-.098 10.16 10.16 0 002.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178A1.17 1.17 0 014.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 01-1.162 1.178 1.17 1.17 0 01-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 01.598.082l1.584.926a.272.272 0 00.14.045c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 01-.023-.156.49.49 0 01.201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.03-.406-.03zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 01-.969.983.976.976 0 01-.969-.983c0-.542.434-.982.969-.982z"/>
              </svg>
              <span class="text-gray-300">扫码添加微信</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10">
      <div class="text-center">
        <p class="text-gray-400 text-sm">
          © {new Date().getFullYear()} 流客科技. All rights reserved.
        </p>
      </div>
    </div>
  </div>

  <style>
    .footer-link {
      @apply text-gray-300 hover:text-white transition-colors duration-300 inline-block;
    }

    .contact-link {
      @apply block transition-transform duration-300 hover:-translate-y-1;
    }
  </style>
</footer>
