---
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import me from "../image/index/me.webp";
import shop from '../image/index/shop.webp';
import Tags from "../pages/tags/index.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  pageTitle: string;
  desc?: string;
  keywords?: string;
  image?: string;
}

const { pageTitle, desc, keywords, image } = Astro.props;

const siteName = "流客科技";
const makeTitle = pageTitle ? `${pageTitle} | ${siteName}` : "流客科技";
const defaultDesc = "流客科技专注于提供优质的通信服务解决方案,包括流量卡、随身WiFi等产品。大流量低资费,全国漫游无限制,让您畅享移动互联。";
const defaultKeywords = "流量卡,随身wifi,流量卡官网,通信服务,流客科技,物联网,5G套餐,手机卡,上网卡";
const defaultImage = "https://www.liuketh.cn/og-image.jpg";

const url = new URL(Astro.url.pathname, Astro.site).toString();
const ishotCard = !!url.match(/hotcard/)
---

<!DOCTYPE html>
<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4F46E5" />
    <meta name="generator" content={Astro.generator} />

    <ViewTransitions />
    
    <!-- DNS预解析 -->
    <link rel="dns-prefetch" href="//www.liuketh.cn" />
    <link rel="preconnect" href="//www.liuketh.cn" />
    
    <!-- 预加载关键资源 -->
    <link rel="preload" href="/fonts/custom-font.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={defaultImage} as="image" />
    
    <!-- Primary Meta Tags -->
    <title>{makeTitle}</title>
    <meta name="title" content={makeTitle} />
    <meta name="description" content={desc || defaultDesc} />
    <meta name="keywords" content={keywords || defaultKeywords} />
    <meta name="author" content={siteName} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={makeTitle} />
    <meta property="og:description" content={desc || defaultDesc} />
    <meta property="og:image" content={image || defaultImage} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={makeTitle} />
    <meta property="twitter:description" content={desc || defaultDesc} />
    <meta property="twitter:image" content={image || defaultImage} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={url} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- 预连接第三方域名 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- 移动 Web App -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    
    <!-- 站点验证 - 请替换为真实的验证代码 -->
    <meta name="baidu-site-verification" content="codeva-XXXXXXXXXX" />
    <meta name="360-site-verification" content="XXXXXXXXXX" />
    <meta name="sogou_site_verification" content="XXXXXXXXXX" />
    <meta name="google-site-verification" content="XXXXXXXXXX" />
    <meta name="bingbot" content="index,follow" />
    
    <!-- 结构化数据 - Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "流客科技",
      "url": "https://www.liuketh.cn",
      "logo": "https://www.liuketh.cn/og-image.jpg",
      "description": "流客科技专注于提供优质的通信服务解决方案,包括流量卡、随身WiFi等产品。大流量低资费,全国漫游无限制,让您畅享移动互联。",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "西安",
        "addressRegion": "陕西省",
        "addressCountry": "CN"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+86-15556355573",
        "contactType": "customer service",
        "availableLanguage": "Chinese"
      },
      "sameAs": [
        "https://www.liuketh.cn"
      ]
    })} />
    
    <!-- 结构化数据 - WebSite + SearchAction -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "流客科技",
      "url": "https://www.liuketh.cn",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.liuketh.cn/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />
    
    <slot name="head" />
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <Header transition:persist />
      <!-- 优化面包屑导航 -->
      <div class="hidden sm:block max-w-8xl mx-auto w-full px-4 ">
        {Astro.url.pathname !=='/' && 
          <nav class="flex py-4 text-sm bg-gradient-to-r from-gray-50 to-white rounded-xl my-4 shadow-sm" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-2 px-4">
              <li class="inline-flex items-center">
                <a href="/" class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors group">
                  <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-white shadow-sm group-hover:shadow-md transition-all duration-300 mr-2">
                    <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                    </svg>
                  </span>
                  <span class="text-sm font-medium">首页</span>
                </a>
              </li>
              {Astro.url.pathname.slice(1).split('/').length > 1 && 
                <li>
                  <div class="flex items-center">
                    <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <a href={`/${Astro.url.pathname.slice(1).split('/')[0]}`} 
                       class="inline-flex items-center text-gray-600 hover:text-blue-600 transition-colors group">
                      <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-white shadow-sm group-hover:shadow-md transition-all duration-300 mx-2">
                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15"></path>
                        </svg>
                      </span>
                      <span class="text-sm font-medium">{Astro.url.pathname.slice(1).split('/')[0]}</span>
                    </a>
                  </div>
                </li>
              }
              <li>
                <div class="flex items-center">
                  <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="flex items-center ml-1">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-50 shadow-sm mx-2">
                      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                    </span>
                    <span class="text-sm font-medium text-gray-800">{pageTitle}</span>
                  </span>
                </div>
              </li>
            </ol>
          </nav>
        }
      </div>

      <div class="flex-grow flex max-w-8xl mx-auto w-full">
        <main class="flex-1 max-w-6xl mx-auto p-4 md:p-12" transition:animate="fade">
          <slot />
        </main>

        <!-- 优化右侧招商信息 -->
        <aside class="hidden xl:block w-[24%] border-l border-gray-100">
          <div class="sticky top-6 p-6 space-y-6">
            <slot name="shop" />
            
            <!-- 私域引流卡片 - 强化版 -->
                <section class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-gradient-to-r from-green-300 to-emerald-400 relative overflow-hidden">
                  <!-- 动态背景光效 -->
                  <div class="absolute inset-0 bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 opacity-80"></div>
                  <div class="absolute top-0 right-0 w-24 h-24 bg-green-200 rounded-full blur-3xl opacity-40"></div>
                  <div class="absolute bottom-0 left-0 w-20 h-20 bg-emerald-200 rounded-full blur-3xl opacity-40"></div>
                  
                  <div class="relative z-10">
                    <h3 class="text-lg font-bold mb-4 text-gray-800 flex items-center gap-2">
                      <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-green-500 to-emerald-600 text-white shadow-lg">
                        💚
                      </span>
                      {ishotCard ? "🎁 扫码免费领取流量卡" : "✨ 添加微信领优惠"}
                    </h3>
                    
                    <!-- 微信二维码展示 - 更大更清晰 -->
                    <div class="relative overflow-hidden rounded-2xl bg-white p-3 shadow-inner">
                      <div class="absolute inset-0 bg-gradient-to-br from-green-100 to-emerald-100"></div>
                      <Image
                        src={ishotCard ? shop : me}
                        width={400}
                        height={400}
                        alt="扫码添加微信领取福利"
                        class="w-full rounded-xl relative z-10 transform hover:scale-105 transition-transform duration-300"
                        loading="eager"
                      />
                      <!-- 扫描提示动画 -->
                      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                        <div class="w-full h-1 bg-gradient-to-r from-transparent via-green-500 to-transparent opacity-70 animate-pulse"></div>
                      </div>
                    </div>
                    
                    <!-- 强化CTA按钮 -->
                    <div class="mt-4 space-y-3">
                      <p class="text-sm text-gray-700 text-center font-medium">
                        📱 扫码添加微信
                      </p>
                      <p class="text-xs text-gray-500 text-center">
                        享专属客服 · 领优惠活动 · 免费领卡
                      </p>
                      
                      <!-- 快捷复制按钮 -->
                      <button 
                        onclick="copyWechat()"
                        class="w-full py-3 px-4 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-bold rounded-xl hover:from-green-600 hover:to-emerald-700 transition-all duration-300 shadow-md hover:shadow-lg flex items-center justify-center gap-2"
                      >
                        <span>📋</span>
                        <span>复制微信号: liuketh</span>
                      </button>
                    </div>
                    
                    <!-- 滚动公告 -->
                    <div class="mt-4 bg-gradient-to-r from-green-100 to-emerald-100 rounded-xl p-3">
                      <div class="flex items-center gap-2 text-sm text-green-700">
                        <span class="animate-pulse">🔔</span>
                        <marquee scrollamount="4" class="flex-1">
                          🚀 已有 <span class="font-bold">{Math.floor((new Date().getTime() - new Date('2024-03-01').getTime() ) / (1000*60*60*24)) + 2000}</span> 人领取了免费的流量卡！🔥 立即扫码抢占名额！
                        </marquee>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- 联系方式卡片 -->
                <section class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300">
                  <h3 class="text-lg font-semibold mb-4 text-gray-800 flex items-center gap-2">
                    <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-blue-50 to-blue-100">
                      📱
                    </span>
                    联系方式
                  </h3>
                  <a href="tel:15556355573" 
                     class="group block text-center py-3 px-4 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-medium rounded-xl hover:from-blue-600 hover:to-blue-700 transition-all duration-300 shadow-sm hover:shadow-md">
                    <span class="group-hover:hidden">155563 55573</span>
                    <span class="hidden group-hover:inline">点击拨打 ></span>
                  </a>
                  <p class="text-xs text-gray-500 text-center mt-2">同微信</p>
                </section>

            <!-- 标签云卡片 -->
            <section class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300">
              <h3 class="text-lg font-semibold mb-4 text-gray-800 flex items-center gap-2">
                <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-blue-50 to-blue-100">
                  🏷️
                </span>
                标签云
              </h3>
              <Tags />
            </section>
          </div>
        </aside>
      </div>
      <Footer transition:persist />
    </div>
  </body>
</html>

<style>
  /* 页面过渡动画 */
  :root {
    --view-transition-duration: 0.3s;
  }
  
  /* 滚动平滑 */
  html {
    scroll-behavior: smooth;
  }
  
  /* 减少动画提升性能 */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // 复制微信号功能
  function copyWechat() {
    navigator.clipboard.writeText('liuketh').then(() => {
      alert('微信号 liuketh 已复制到剪贴板，打开微信添加好友即可！');
    }).catch(() => {
      // 兼容旧浏览器
      const textarea = document.createElement('textarea');
      textarea.value = 'liuketh';
      document.body.appendChild(textarea);
      textarea.select();
      // @ts-ignore
      document.execCommand('copy');
      document.body.removeChild(textarea);
      alert('微信号 liuketh 已复制到剪贴板，打开微信添加好友即可！');
    });
  }
  
  // 将函数挂载到window上供onclick调用
  // @ts-ignore
  window.copyWechat = copyWechat;
</script>
