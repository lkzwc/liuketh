---
import { getCollection } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import MDContent from "../../components/MDContent.astro";
import MDLayout from "../../layouts/MD.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("ukcard");
  return blogEntries.map((entry) => ({
    params: {
      slug: entry.slug,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  entry: {
    data: { title, description, tags },
  },
} = Astro.props;
const { slug } = Astro.params;
const { Content } = await entry.render();
const allPosts = await getCollection("ukcard");
const pageKeywords = tags.join(",");
---

<Layout pageTitle={title} desc={description} keywords={pageKeywords}>
  <div>
    <MDLayout frontmatter={entry.data}>
      <MDContent class="rounded-xl">
        <Content />
      </MDContent>
    </MDLayout>

    <RelatedPosts
      posts={allPosts}
      currentSlug={slug}
      basePath="ukcard"
    />
  </div>
</Layout>
